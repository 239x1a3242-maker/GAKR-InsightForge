# Application
APP_NAME="Enterprise BI & AutoML Platform"
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# File-based Database System (no PostgreSQL/Redis needed!)
FILE_BASED_DB=true
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Security  
SECRET_KEY=sample_dev_secret_change_me_before_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload
MAX_UPLOAD_SIZE_MB=500

# H2O Configuration
H2O_PORT=54321
H2O_IP=localhost

# LLM Configuration
LLM_MODEL_NAME=HuggingFaceTB/SmolLM-135M-Instruct
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# Query Engine
MAX_QUERY_ROWS=1000000
QUERY_TIMEOUT_SECONDS=300

# CORS (Frontend URLs)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173
# Logging
LOG_LEVEL=INFO
